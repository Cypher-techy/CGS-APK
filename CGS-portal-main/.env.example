# Copy to .env.local and fill in. Never commit real values.
# Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx
# Public base URL of this deployment (used in e-mail confirmation and password reset links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: contact e-mail shown on the public site. Leave empty to show none.
NEXT_PUBLIC_CONTACT_EMAIL=

# ---- FERD Student Portal (server-side only: never prefix these with NEXT_PUBLIC_) ----
# Supabase dashboard > Project Settings > API > secret key. Needed for FERD sign-in, file links and payments.
SUPABASE_SECRET_KEY=
# M-Pesa Daraja STK Push. Keep MPESA_ENABLED=false until one real payment has been tested end to end.
MPESA_ENABLED=false
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://YOUR-DOMAIN/api/payments/callback
# Buy Goods till only: CustomerBuyGoodsOnline, and the till number as MPESA_PARTY_B.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_PARTY_B=
# Optional shared token; if set, add ?token=<value> to MPESA_CALLBACK_URL.
MPESA_CALLBACK_TOKEN=
# AI study assistant (optional). Create a key in Google AI Studio; server-side only.
GEMINI_API_KEY=
# Optional Gemini model override. Default: gemini-2.5-flash
FERD_ASSISTANT_MODEL=
